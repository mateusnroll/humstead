#!/bin/bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
if [[ -z "${DEVELOPER_DIR:-}" && -d /Applications/Xcode.app/Contents/Developer ]]; then
  export DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
fi
xcodebuild -version >/dev/null
xcrun --sdk macosx --show-sdk-path >/dev/null
xcrun swift --version >/dev/null
mkdir -p "$ROOT/.build/ModuleCache" "$ROOT/.build/results"
export CLANG_MODULE_CACHE_PATH="$ROOT/.build/ModuleCache"
export SWIFT_MODULE_CACHE_PATH="$ROOT/.build/ModuleCache"
BUILD_ARGS=(-project Humstead.xcodeproj -scheme Humstead -destination 'platform=macOS,arch=arm64' -derivedDataPath "$ROOT/.build/DerivedData")
